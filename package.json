{
  "name": "contextroute",
  "version": "0.1.0",
  "description": "Evidence-based model and repository-context routing for OpenCode",
  "main": "./dist/plugin/index.js",
  "bin": { "contextroute": "./dist/cli.js" },
  "scripts": {
    "test": "npm run build && node --test tests/unit.test.mjs tests/desktop.test.mjs tests/public-benchmark.test.mjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.gui.json && vite build",
    "test:integration": "npm run build && node --test tests/opencode.integration.test.mjs",
    "demo": "node examples/desktop-demo.mjs",
    "prepack": "npm run build"
  },
  "type": "module",
  "devDependencies": {
    "@opencode/plugin": "2.2.7",
    "@types/node": "24.19.2",
    "solid-js": "1.9.20",
    "typescript": "7.0.2",
    "vite": "7.3.8",
    "vite-plugin-solid": "2.11.17"
  },
  "exports": {
    "./server": "./dist/plugin/index.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "yaml": "2.9.1"
  }
}
